# Optional – enables Generative AI triage, vision and handover notes.
# The app works fully without it using the offline engines.
# Gemini: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude (alternative)
ANTHROPIC_API_KEY=
# When both keys are set: gemini | claude
SEHAT_AI_PROVIDER=

# 64 hex characters (openssl rand -hex 32). Encrypts patient details at rest
# with AES-256-GCM. Without it a random key is generated at every start.
SEHAT_DATA_KEY=

# Real road routes (public OSRM server, OpenStreetMap). off = straight lines.
SEHAT_ROUTING=on
# SEHAT_OSRM_URL=https://router.project-osrm.org
# 1 = own-vehicle trip is simulated until the phone's GPS shows movement, 0 = GPS only
SEHAT_SIMULATE_VEHICLE=1

PORT=3000
SEHAT_DEMO_SPEED=15

# 108 / 102 control room (CAD). Without these a SIMULATED control room is used.
# Practice control room on this same server: SEHAT_PRACTICE_CAD=on and
# SEHAT_EMS_URL=http://localhost:3000/api/practice-cad/incidents
SEHAT_PRACTICE_CAD=
SEHAT_EMS_URL=
SEHAT_EMS_SECRET=
# Emergency by SMS (gateway). Without these only the demo simulator works.
SEHAT_SMS_NUMBER=
SEHAT_SMS_SECRET=
SEHAT_SMS_SEND_URL=
SEHAT_SMS_SEND_TOKEN=
# Base URL used in tracking links sent by SMS (Render sets RENDER_EXTERNAL_URL itself)
SEHAT_PUBLIC_URL=
